# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URL (used for auth redirects + invite links + OAuth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (team invitations + email marketing)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=GrowthOS <onboarding@resend.dev>
# Webhook endpoint: POST {NEXT_PUBLIC_SITE_URL}/api/email/webhooks/resend
# RESEND_WEBHOOK_SECRET=

# Signed unsubscribe tokens for campaign footers
EMAIL_UNSUBSCRIBE_SECRET=

# Anthropic (Research + Content agents)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Inngest (background jobs: research, content, social, email campaigns)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Token encryption (32 bytes, base64) — required for social_connections
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# Meta (Facebook + Instagram)
META_APP_ID=
META_APP_SECRET=
# Webhook verify token (Meta App → Webhooks → Verify Token)
# Callback: {NEXT_PUBLIC_SITE_URL}/api/social/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=
# Set true only after Instagram permissions are approved on the Meta app
# META_REQUEST_IG_SCOPES=true

# X API v2
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Default connects to company Pages. Set true only for personal-profile posting.
# LINKEDIN_MEMBER_MODE=true

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# YouTube (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paid ads (Phase 7) — see docs/ads-apis.md
ADS_WRITES_ENABLED=false
# Optional platform gates. Phase C implements Meta + Google only.
ADS_WRITES_META=false
ADS_WRITES_GOOGLE=false
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# MCC / manager account used as login-customer-id header (digits only or with dashes)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional override for the pinned Google Ads API version (default v25). Sunset
# versions return HTML 404s, so bump this if Google sunsets the default.
GOOGLE_ADS_API_VERSION=
# Optional: for scripts/test-google-ads-mcc.ts
# GOOGLE_ADS_TEST_REFRESH_TOKEN=
# GOOGLE_ADS_TEST_CUSTOMER_ID=
# GOOGLE_ADS_TEST_CAMPAIGN_ID=
# MICROSOFT_ADS_CLIENT_ID=
# MICROSOFT_ADS_CLIENT_SECRET=
# MICROSOFT_ADS_DEVELOPER_TOKEN=

# SEO (Phase 8) — see docs/seo.md
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET for GSC OAuth
PAGESPEED_API_KEY=
SEO_AUDIT_PAGE_CAP=40

# CRM (Phase 12) — form + Shopify/WooCommerce webhooks
CRM_WEBHOOK_SECRET=

# Finance / billing (Phase 13)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# Data / analytics (Phase 14) — GA4 OAuth reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# Enable Analytics Read-only + Admin API on the Google Cloud OAuth client

# Observability (optional — disabled when unset)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Testing (optional)
# GROWTHOS_TEST_USER_A_EMAIL=
# GROWTHOS_TEST_USER_A_PASSWORD=
# GROWTHOS_TEST_USER_B_EMAIL=
# GROWTHOS_TEST_USER_B_PASSWORD=
# PLAYWRIGHT_SMOKE_EMAIL=
# PLAYWRIGHT_SMOKE_PASSWORD=
# DATABASE_URL=

# Later milestones
# (none)
